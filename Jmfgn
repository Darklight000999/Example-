<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#050505">
<title>QR Studio — Liquid Glass QR Generator</title>

<!-- QR ENGINE -->
<script src="https://cdn.jsdelivr.net/npm/qr-code-styling@1.9.2/lib/qr-code-styling.js"></script>

<style>
/* =========================================================
   LIQUID GLASS QR STUDIO - CUSTOM RED & GOLD THEME
========================================================= */
:root{
    --bg:#050505;
    --bg2:#0a0a0a;
    --glass:rgba(212,175,55,.075);
    --glass2:rgba(212,175,55,.11);
    --border:rgba(212,175,55,.25);
    --border2:rgba(212,175,55,.15);
    --text:#F4F4F4;
    --muted:rgba(244,244,244,.58);
    --accent:#8B0000;
    --accent2:#D4AF37;
    --green:#34d399;
    --shadow:0 25px 80px rgba(0,0,0,.6);
    --radius:24px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{
    min-width:320px;
    min-height:100vh;
    color:var(--text);
    font-family:Inter,-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Segoe UI",Roboto,Arial,sans-serif;
    background:
        radial-gradient(circle at 10% 5%,rgba(139,0,0,.3),transparent 32%),
        radial-gradient(circle at 90% 10%,rgba(212,175,55,.2),transparent 30%),
        radial-gradient(circle at 50% 100%,rgba(139,0,0,.2),transparent 40%),
        linear-gradient(145deg,#050505,#0a0a0a 48%,#000000);
    overflow-x:hidden;
    padding-bottom:calc(95px + env(safe-area-inset-bottom));
}
body::before,body::after{content:"";position:fixed;width:280px;height:280px;border-radius:50%;filter:blur(80px);pointer-events:none;z-index:-1;}
body::before{left:-100px;top:35%;background:rgba(139,0,0,.25);animation:floatBlob 10s ease-in-out infinite;}
body::after{right:-100px;top:55%;background:rgba(212,175,55,.2);animation:floatBlob2 12s ease-in-out infinite;}
@keyframes floatBlob{0%,100%{transform:translate3d(0,0,0);}50%{transform:translate3d(60px,-50px,0);}}
@keyframes floatBlob2{0%,100%{transform:translate3d(0,0,0);}50%{transform:translate3d(-70px,40px,0);}}
.app{width:100%;max-width:1200px;margin:auto;padding:18px 14px 30px;}
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
.brand{display:flex;flex-direction:column;}
.brand-title{font-size:25px;line-height:1;font-weight:900;letter-spacing:-1.4px;background:linear-gradient(90deg,#F4F4F4,#D4AF37,#8B0000,#F4F4F4);background-size:250% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:gradientMove 6s linear infinite;}
.brand-title span{color:#D4AF37;}
.brand-subtitle{margin-top:6px;color:var(--muted);font-size:10px;letter-spacing:.12em;}
@keyframes gradientMove{0%{background-position:0%;}100%{background-position:250%;}}
.header-actions{display:flex;gap:7px;}
.icon-btn{width:40px;height:40px;border-radius:14px;border:1px solid var(--border);color:white;background:linear-gradient(135deg,rgba(255,255,255,.1),rgba(255,255,255,.02));backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:inset 0 1px rgba(255,255,255,.1),0 8px 25px rgba(0,0,0,.3);font-size:17px;transition:.25s; cursor:pointer;}
.icon-btn:active{transform:scale(.9);}
.workspace{display:grid;gap:14px;}
.glass{border:1px solid var(--border);background:linear-gradient(145deg,rgba(212,175,55,.08),rgba(212,175,55,.02));backdrop-filter:blur(28px) saturate(145%);-webkit-backdrop-filter:blur(28px) saturate(145%);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),inset 0 -1px rgba(255,255,255,.03),var(--shadow);}
.preview-card{position:relative;overflow:hidden;border-radius:30px;padding:16px;text-align:center;}
.preview-card::before{content:"";position:absolute;inset:-2px;background:linear-gradient(120deg,transparent 25%,rgba(212,175,55,.2),transparent 70%);transform:translateX(-100%);animation:glassShine 7s ease-in-out infinite;pointer-events:none;}
@keyframes glassShine{0%,55%{transform:translateX(-100%);}75%,100%{transform:translateX(100%);}}
.preview-head{position:relative;display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.preview-title{font-size:11px;font-weight:800;letter-spacing:.13em;color:rgba(244,244,244,.72);}
.live-pill{display:flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:rgba(52,211,153,.10);border:1px solid rgba(52,211,153,.25);color:#65e6b4;font-size:9px;font-weight:800;}
.live-dot{width:5px;height:5px;border-radius:50%;background:#34d399;box-shadow:0 0 10px #34d399;animation:pulse 1.5s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.45;transform:scale(.7);}}

/* QR STAGE & FRAMES */
.qr-stage{position:relative;width:min(100%,330px);aspect-ratio:1;margin:auto;display:grid;place-items:center;border-radius:28px;background:linear-gradient(145deg,rgba(244,244,244,.94),rgba(230,230,230,.94));box-shadow:0 25px 60px rgba(0,0,0,.45),inset 0 0 0 1px rgba(255,255,255,.9);}
.qr-stage::before{content:"";position:absolute;inset:-2px;border-radius:30px;background:linear-gradient(135deg,rgba(139,0,0,.8),transparent 40%,rgba(212,175,55,.7));z-index:-1;filter:blur(8px);opacity:.65;}

/* NEW: Outer Frame Wrapper */
#qrFrameWrapper {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
    max-width: 90%;
    max-height: 90%;
}
#qrPreview{width:100%;height:100%;display:grid;place-items:center;}
#qrPreview canvas,#qrPreview svg{max-width:100%;max-height:100%;border-radius:8px;}

/* Custom CSS Frames */
.qrf-none { padding: 0; background: transparent; border: none; }
.qrf-phone { padding: 12px 10px 35px 10px; background: #222; border-radius: 20px; border: 2px solid #444; box-shadow: inset 0 0 0 4px #111; }
.qrf-polaroid { padding: 12px 12px 40px 12px; background: #fff; border: 1px solid #ddd; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
.qrf-clipboard { padding: 30px 12px 12px 12px; background: #D4AF37; border-radius: 6px; position:relative; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
.qrf-clipboard::before { content:''; position:absolute; top:-8px; left:50%; transform:translateX(-50%); width:40px; height:12px; background:#8B0000; border-radius:4px; border:2px solid #fff; }
.qrf-monitor { padding: 10px 10px 30px 10px; background: #333; border-radius: 8px 8px 0 0; border: 2px solid #555; position:relative; }
.qrf-monitor::after { content:''; position:absolute; bottom:5px; left:50%; transform:translateX(-50%); width:30px; height:4px; background:#666; border-radius:2px; }
.qrf-envelope { padding: 35px 15px 15px 15px; background: #F4F4F4; border: 2px solid #ccc; border-radius: 4px; position:relative; }
.qrf-envelope::before { content:''; position:absolute; top:0; left:0; right:0; height:25px; background:linear-gradient(135deg, #e0e0e0 50%, transparent 50%); border-radius: 4px 4px 0 0; }
.qrf-bubble { padding: 15px; background: #fff; border-radius: 15px; position:relative; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
.qrf-bubble::after { content:''; position:absolute; bottom:-10px; left:20px; border-width: 10px 10px 0 0; border-style:solid; border-color: #fff transparent transparent transparent; }
.qrf-ticket { padding: 15px; background: #F4F4F4; border: 3px dashed #8B0000; border-radius: 12px; }
.qrf-badge { padding: 15px; background: #fff; border: 4px solid #D4AF37; border-radius: 50%; box-shadow: 0 0 0 4px #8B0000; }
.qrf-badge #qrPreview canvas { border-radius: 50% !important; }
.qrf-tablet { padding: 20px 10px; background: #111; border-radius: 12px; border: 3px solid #666; }
.qrf-card { padding: 10px 40px 10px 10px; background: linear-gradient(135deg, #8B0000, #4a0000); border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }

/* Scan Label */
.scan-label{position:absolute;left:50%;bottom:-13px;transform:translateX(-50%);white-space:nowrap;padding:8px 18px;border-radius:999px;color:#F4F4F4;background:linear-gradient(135deg,#8B0000,#4a0000);border:1px solid rgba(212,175,55,.5);box-shadow:0 8px 25px rgba(0,0,0,.5);font-size:11px;font-weight:850;letter-spacing:.08em;backdrop-filter:blur(20px); z-index:3;}

.main-tabs{display:grid;grid-template-columns:1fr 1fr;padding:4px;margin-top:10px;border-radius:18px;background:rgba(212,175,55,.08);border:1px solid var(--border2);}
.main-tab{height:44px;border:0;border-radius:14px;color:var(--muted);background:transparent;font-size:12px;font-weight:800;transition:.3s; cursor:pointer;}
.main-tab.active{color:#F4F4F4;background:linear-gradient(135deg,#8B0000,#D4AF37);box-shadow:0 8px 25px rgba(139,0,0,.4),inset 0 1px rgba(255,255,255,.35);}
.panel{border-radius:24px;padding:15px;margin-top:14px;}
.hidden{display:none!important;}
.section-label{display:block;margin-bottom:7px;font-size:11px;font-weight:800;color:rgba(244,244,244,.72);}
.input{width:100%;height:47px;padding:0 14px;border-radius:14px;border:1px solid var(--border);outline:none;color:#F4F4F4;background:rgba(0,0,0,.3);transition:.25s;}
.input::placeholder{color:rgba(244,244,244,.35);}
.input:focus{border-color:rgba(212,175,55,.75);box-shadow:0 0 0 3px rgba(212,175,55,.15);}
.generate-btn{width:100%;height:46px;margin-top:9px;border-radius:14px;color:#F4F4F4;font-weight:850;border:1px solid rgba(255,255,255,.2);background:linear-gradient(100deg,#8B0000,#D4AF37,#8B0000);background-size:200% 100%;box-shadow:0 12px 30px rgba(139,0,0,.4),inset 0 1px rgba(255,255,255,.35);animation:buttonGradient 5s linear infinite;transition:.2s; cursor:pointer;}
@keyframes buttonGradient{0%{background-position:0%;}100%{background-position:200%;}}
.generate-btn:active{transform:scale(.98);}
.design-tabs{display:grid;grid-template-columns:repeat(4,1fr);margin:-15px -15px 15px;border-bottom:1px solid var(--border2);}
.design-tab{position:relative;height:48px;border:0;color:var(--muted);background:transparent;font-size:10px;font-weight:850;transition:.25s; cursor:pointer;}
.design-tab.active{color:#F4F4F4;}
.design-tab.active::after{content:"";position:absolute;left:20%;right:20%;bottom:-1px;height:2px;border-radius:10px;background:linear-gradient(90deg,#8B0000,#D4AF37);box-shadow:0 0 12px rgba(212,175,55,.6);}
.design-panel{display:none;animation:panelIn .25s ease;}
.design-panel.active{display:block;}
@keyframes panelIn{from{opacity:0;transform:translateY(7px);}to{opacity:1;transform:none;}}
.section-title-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.section-title{font-size:14px;font-weight:850;}
.view-all{border:0;color:#D4AF37;background:transparent;font-size:10px;font-weight:800; cursor:pointer;}
.section-subtitle{margin-top:-5px;margin-bottom:12px;color:var(--muted);font-size:10px;}
.option-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;}
.option{position:relative;min-width:0;aspect-ratio:1;border-radius:14px;border:1px solid var(--border);background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.01));color:#F4F4F4;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;transition:transform .2s,border-color .2s,background .2s,box-shadow .2s; cursor:pointer;}
.option:hover{border-color:rgba(212,175,55,.45);}
.option:active{transform:scale(.94);}
.option.active{transform:scale(1.035);border-color:rgba(212,175,55,.95);background:linear-gradient(145deg,rgba(139,0,0,.3),rgba(212,175,55,.15));box-shadow:0 8px 24px rgba(139,0,0,.3),inset 0 1px rgba(255,255,255,.2);}
.option.active::before{content:"✓";position:absolute;top:5px;right:6px;width:15px;height:15px;display:grid;place-items:center;border-radius:50%;color:#050505;background:#D4AF37;font-size:8px;font-weight:900; z-index:5;}
.option-name{max-width:90%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:8px;font-weight:800;color:rgba(244,244,244,.78);}
.option-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:11px;font-size:20px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08);}

/* STICKERS */
.sticker-preview{position:relative;width:43px;height:36px;display:grid;place-items:center;color:#F4F4F4;font-size:7px;font-weight:900;border:1.5px solid currentColor;border-radius:8px;}
.sticker-rounded{border-radius:16px;}
.sticker-dashed{border-style:dashed;}
.sticker-double{border-width:3px;}
.sticker-pill{width:48px;height:22px;border-radius:999px;}
.sticker-arrow::after{content:"";position:absolute;right:-7px;width:12px;height:12px;border-top:2px solid currentColor;border-right:2px solid currentColor;transform:rotate(45deg);}
.sticker-bubble{border-radius:50%;}
.sticker-ticket{border-radius:4px;}

/* FRAME PREVIEWS */
.frame-preview{width:38px;height:38px;display:grid;place-items:center;background:rgba(255,255,255,.1);border-radius:8px;border:1px solid rgba(255,255,255,.2);}
.fp-phone{width:22px;height:32px;border:2px solid #F4F4F4;border-radius:4px;border-bottom-width:6px;}
.fp-polaroid{width:28px;height:32px;background:#F4F4F4;border-bottom:8px solid #F4F4F4; position:relative;}
.fp-polaroid::after{content:'';position:absolute;inset:2px;background:#333;}
.fp-clip{width:26px;height:30px;border:2px solid #F4F4F4;border-radius:2px;position:relative;}
.fp-clip::before{content:'';position:absolute;top:-4px;left:6px;right:6px;height:4px;background:#F4F4F4;}
.fp-env{width:30px;height:22px;border:2px solid #F4F4F4;position:relative;}
.fp-env::before{content:'';position:absolute;top:0;left:0;border-width:10px 13px 0 13px;border-style:solid;border-color:#F4F4F4 transparent transparent transparent;}
.fp-bub{width:28px;height:24px;border:2px solid #F4F4F4;border-radius:6px;position:relative;}
.fp-bub::after{content:'';position:absolute;bottom:-6px;left:4px;border-width:6px 6px 0 0;border-style:solid;border-color:#F4F4F4 transparent transparent transparent;}

/* SHAPES & EDGES (Existing 9 edges & valid patterns) */
.shape-preview{width:42px;height:42px;display:grid;grid-template-columns:repeat(4,1fr);gap:3px;padding:4px;}
.shape-preview i{background:#F4F4F4;display:block;}
.shape-square i{border-radius:0;} .shape-rounded i{border-radius:4px;} .shape-dot i{border-radius:50%;} .shape-soft i{border-radius:8px;} .shape-classy i{border-radius:10px 0 10px 0;} .shape-classy-rnd i{border-radius:50% 50% 0 50%;}
.edge-preview{width:32px;height:32px;border:3px solid #F4F4F4;display:grid;place-items:center;}
.edge-preview i{width:12px;height:12px;background:#F4F4F4;display:block;}
.e-sq{border-radius:0;} .e-sq i{border-radius:0;} .e-rnd{border-radius:8px;} .e-rnd i{border-radius:50%;} .e-dt{border-radius:50%;} .e-dt i{border-radius:50%;} .e-rnd-sq{border-radius:8px;} .e-rnd-sq i{border-radius:0;} .e-sq-dt{border-radius:0;} .e-sq-dt i{border-radius:50%;} .e-dt-sq{border-radius:50%;} .e-dt-sq i{border-radius:0;}
.e-ruby{border-color:#8B0000 !important;} .e-ruby i{background:#8B0000 !important;} .e-gold{border-color:#D4AF37 !important;} .e-gold i{background:#D4AF37 !important;} .e-mix-color{border-color:#8B0000 !important;} .e-mix-color i{background:#D4AF37 !important;}

/* LOGOS */
.logo-symbol{width:40px;height:40px;display:grid;place-items:center;border-radius:11px;color:#F4F4F4;font-weight:950;font-size:18px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.09);}
.youtube{background:#ff0033;} .instagram{background:linear-gradient(135deg,#7c28ff,#ff315f,#ffc93c);} .facebook{background:#1877f2;} .whatsapp{background:#25d366;} .tiktok{background:#000;} .linkedin{background:#0a66c2;} .telegram{background:#229ed9;} .pinterest{background:#e60023;} .snapchat{background:#ffe600;color:#111;} .xlogo{background:#000;} .discord{background:#5865f2;} .spotify{background:#1ed760;color:#111;} .vimeo{background:#19b7ea;} .twitch{background:#9146ff;} .netflix{background:#e50914;} .apple{background:#111;}

.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;}
.upload-btn{min-height:74px;border-radius:15px;border:1px dashed rgba(212,175,55,.45);background:linear-gradient(145deg,rgba(139,0,0,.15),rgba(212,175,55,.08));color:#F4F4F4;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center;transition:.2s; cursor:pointer;}
.upload-btn:active{transform:scale(.97);}
.upload-icon{font-size:22px;}
.upload-btn strong{font-size:10px;}
.upload-btn small{font-size:8px;color:var(--muted);}
.upload-btn input{display:none;}
.color-preview{width:42px;height:42px;border-radius:13px;border:1px solid rgba(255,255,255,.18);box-shadow:inset 0 1px rgba(255,255,255,.3);}
.c-black{background:#050505;} .c-white{background:#F4F4F4;} .c-red{background:#8B0000;} .c-yellow{background:#D4AF37;} .c-green{background:#22c55e;} .c-blue{background:#3182ff;} .c-purple{background:#8b5cf6;} .c-pink{background:#ec4899;} .c-cyan{background:#06b6d4;} .c-orange{background:#f97316;} .c-gradient{background:linear-gradient(135deg,#8B0000,#D4AF37,#8B0000);}
.color-picker-wrap{position:relative;height:46px;border-radius:13px;overflow:hidden;border:1px solid var(--border);}
.color-picker{width:100%;height:100%;border:0;padding:0;background:transparent;cursor:pointer;}
.extract-box{margin-top:13px;padding:12px;border-radius:17px;border:1px solid rgba(212,175,55,.15);background:rgba(0,0,0,.3);}
.extract-row{display:flex;align-items:center;gap:10px;}
.extract-thumb{width:48px;height:48px;border-radius:12px;object-fit:cover;background:linear-gradient(135deg,#111,#222);border:1px solid rgba(255,255,255,.14);}
.extract-info{flex:1;}
.extract-info strong{display:block;font-size:11px;}
.extract-info small{display:block;margin-top:3px;color:var(--muted);font-size:8px;}
.extract-btn{height:34px;padding:0 11px;border-radius:10px;border:1px solid rgba(212,175,55,.25);background:rgba(212,175,55,.15);color:#D4AF37;font-size:9px;font-weight:850; cursor:pointer;}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;}
.quick{min-height:66px;border-radius:14px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:#F4F4F4;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;transition:.2s; cursor:pointer;}
.quick:active{transform:scale(.94);}
.quick-icon{font-size:20px;}
.quick-name{font-size:8px;color:var(--muted);font-weight:800;}
.history{display:flex;gap:7px;overflow-x:auto;padding-bottom:3px;scrollbar-width:none;}
.history::-webkit-scrollbar{display:none;}
.history-item{flex:0 0 68px;height:68px;border-radius:13px;padding:4px;background:#F4F4F4;border:1px solid rgba(255,255,255,.15);}
.history-item img{width:100%;height:100%;object-fit:contain;border-radius:9px;}
.status{min-height:18px;text-align:center;margin:9px 0;color:var(--muted);font-size:9px;}
.download-bar{position:fixed;z-index:100;left:0;right:0;bottom:0;padding:9px 12px calc(9px + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(5,5,5,.3),rgba(5,5,5,.95));backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-top:1px solid rgba(212,175,55,.15);}
.download-inner{width:100%;max-width:1180px;margin:auto;display:grid;grid-template-columns:48px 1fr 48px;gap:8px;}
.download-side{width:48px;height:48px;border-radius:15px;border:1px solid var(--border);color:#F4F4F4;background:rgba(212,175,55,.1);font-size:18px; cursor:pointer;}
.download-btn{height:48px;border-radius:15px;border:1px solid rgba(255,255,255,.25);color:#F4F4F4;background:linear-gradient(100deg,#8B0000,#D4AF37,#8B0000);box-shadow:0 10px 35px rgba(139,0,0,.4),inset 0 1px rgba(255,255,255,.35);font-weight:900;transition:.2s; cursor:pointer;}
.download-btn:active{transform:scale(.98);}
.download-btn small{display:block;margin-top:2px;font-size:7px;opacity:.75;}
@media(min-width:760px){
    body{padding-bottom:30px;}
    .app{padding-top:28px;}
    .workspace{grid-template-columns:minmax(330px, .95fr) minmax(360px, 1.05fr);align-items:start;}
    .preview-column{position:sticky;top:20px;}
    .download-bar{position:static;margin-top:14px;background:transparent;border:0;padding:0;}
    .download-inner{grid-template-columns:56px 1fr 56px;}
    .download-side{width:56px;height:54px;}
    .download-btn{height:54px;}
}
@media(max-width:360px){
    .app{padding-left:10px;padding-right:10px;}
    .option-grid{gap:5px;}
    .option-name{font-size:7px;}
    .option-icon,.logo-symbol,.color-preview{transform:scale(.9);}
    .upload-grid{gap:6px;}
}
</style>
</head>
<body>

<div class="app">

    <!-- HEADER -->
    <header class="header">
        <div class="brand">
            <div class="brand-title">QR <span>STUDIO</span></div>
            <div class="brand-subtitle">CREATE • CUSTOMIZE • SHARE</div>
        </div>
        <div class="header-actions">
            <button class="icon-btn" id="themeBtn">☾</button>
            <button class="icon-btn" id="historyBtn">◫</button>
            <button class="icon-btn" id="settingsBtn">⚙</button>
        </div>
    </header>

    <!-- WORKSPACE -->
    <main class="workspace">

