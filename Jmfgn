<script>
    // Initialize QR Code Styling Engine
    const qrCode = new QRCodeStyling({
        width: 300,
        height: 300,
        data: "https://example.com",
        image: "",
        dotsOptions: { color: "#050505", type: "square" },
        cornersSquareOptions: { type: "square" },
        cornersDotOptions: { type: "square" },
        backgroundOptions: { color: "transparent" },
        imageOptions: { crossOrigin: "anonymous", margin: 10 }
    });

    qrCode.append(document.getElementById("qrPreview"));

    // --- Main Tab Switching ---
    const websiteTab = document.getElementById("websiteTab");
    const designTab = document.getElementById("designTab");
    
    websiteTab.addEventListener("click", () => {
        websiteTab.classList.add("active");
        designTab.classList.remove("active");
        document.getElementById("websitePanel").classList.remove("hidden");
        document.getElementById("quickPanel").classList.remove("hidden");
        document.getElementById("historyPanel").classList.remove("hidden");
        document.getElementById("designMobilePanel").classList.remove("hidden");
        if (window.innerWidth < 760) document.getElementById("designStudio").classList.add("hidden");
    });

    designTab.addEventListener("click", () => {
        designTab.classList.add("active");
        websiteTab.classList.remove("active");
        if (window.innerWidth < 760) {
            document.getElementById("websitePanel").classList.add("hidden");
            document.getElementById("quickPanel").classList.add("hidden");
            document.getElementById("historyPanel").classList.add("hidden");
            document.getElementById("designMobilePanel").classList.add("hidden");
        }
        document.getElementById("designStudio").classList.remove("hidden");
    });

    document.getElementById("openDesign").addEventListener("click", () => designTab.click());

    // --- Update QR on URL Change ---
    document.getElementById("generateBtn").addEventListener("click", () => {
        const val = document.getElementById("urlInput").value;
        if(val) qrCode.update({ data: val });
    });

    // --- Quick Create Buttons ---
    document.querySelectorAll(".quick").forEach(btn => {
        btn.addEventListener("click", () => {
            let type = btn.getAttribute("data-type");
            let newVal = "https://example.com";
            switch(type) {
                case 'url': newVal = "https://"; break;
                case 'wifi': newVal = "WIFI:S:MyNetwork;T:WPA;P:MyPassword;;"; break;
                case 'text': newVal = "Hello from QR Studio!"; break;
                case 'email': newVal = "mailto:someone@example.com"; break;
                case 'phone': newVal = "tel:+1234567890"; break;
                case 'sms': newVal = "sms:+1234567890"; break;
                case 'vcard': newVal = "BEGIN:VCARD\nVERSION:3.0\nFN:John Doe\nTEL:123456789\nEND:VCARD"; break;
                case 'upi': newVal = "upi://pay?pa=your-upi-id@bank"; break;
            }
            document.getElementById("urlInput").value = newVal;
            qrCode.update({ data: newVal });
        });
    });

    // --- Design Sub-Tab Switching ---
    const designSubTabs = document.querySelectorAll('.design-tab');
    const designPanels = document.querySelectorAll('.design-panel');
    designSubTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            designSubTabs.forEach(t => t.classList.remove('active'));
            designPanels.forEach(p => p.classList.remove('active'));
            tab.classList.add('active');
            document.getElementById(tab.getAttribute('data-design')).classList.add('active');
        });
    });

    // --- OUTER FRAMES Logic ---
    const qrFrameWrapper = document.getElementById("qrFrameWrapper");
    document.querySelectorAll('.frame-option').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.frame-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const frameClass = btn.getAttribute('data-frame');
            qrFrameWrapper.className = frameClass; // Update wrapper class
        });
    });

    // --- Sticker Labels Logic ---
    const scanLabel = document.getElementById("scanLabel");
    function resetStickerStyles() {
        scanLabel.style.background = '';
        scanLabel.style.padding = '';
        scanLabel.style.border = '';
        scanLabel.style.boxShadow = '';
    }

    document.querySelectorAll('.sticker-option').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.sticker-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('customStickerText').value = ''; 
            const labelText = btn.getAttribute('data-label');
            const styleClass = btn.getAttribute('data-class');
            resetStickerStyles();
            scanLabel.innerText = labelText;
            scanLabel.className = 'scan-label ' + styleClass;
            scanLabel.style.display = 'block';
        });
    });

    document.getElementById('customStickerText').addEventListener('input', (e) => {
        resetStickerStyles();
        if(e.target.value.trim() !== '') {
            scanLabel.innerText = e.target.value;
            scanLabel.style.display = 'block';
        } else {
            const activeBtn = document.querySelector('.sticker-option.active');
            if(activeBtn) scanLabel.innerText = activeBtn.getAttribute('data-label');
        }
    });

    document.getElementById('customStickerUpload').addEventListener('change', function(e) {
        if(e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function(event) {
                document.getElementById('customStickerText').value = ''; 
                scanLabel.innerHTML = `<img src="${event.target.result}" style="height:28px; width:auto; border-radius:4px; display:block;">`;
                scanLabel.style.display = 'block';
                scanLabel.className = 'scan-label'; 
                scanLabel.style.background = 'transparent';
                scanLabel.style.padding = '0';
                scanLabel.style.border = 'none';
                scanLabel.style.boxShadow = 'none';
            }
            reader.readAsDataURL(e.target.files[0]);
        }
    });

    // --- Color Logic ---
    document.querySelectorAll('.color-option').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.color-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const dotColor = btn.getAttribute('data-color');
            if(dotColor) {
                document.getElementById('customColorDots').value = dotColor;
                const updateObj = { dotsOptions: { color: dotColor } };
                const activeEdge = document.querySelector('.edge-option.active');
                if(activeEdge && !activeEdge.getAttribute('data-ecolor')) {
                    updateObj.cornersSquareOptions = { color: dotColor };
                    updateObj.cornersDotOptions = { color: dotColor };
                }
                qrCode.update(updateObj);
            }
        });
    });

    document.getElementById('applyColorsBtn').addEventListener('click', () => {
        const dotColor = document.getElementById('customColorDots').value;
        const bgColor = document.getElementById('customColorBg').value;
        document.querySelectorAll('.color-option').forEach(b => b.classList.remove('active'));
        const updateObj = { 
            dotsOptions: { color: dotColor },
            backgroundOptions: { color: bgColor }
        };
        const activeEdge = document.querySelector('.edge-option.active');
        if(activeEdge && !activeEdge.getAttribute('data-ecolor')) {
            updateObj.cornersSquareOptions = { color: dotColor };
            updateObj.cornersDotOptions = { color: dotColor };
        }
        qrCode.update(updateObj);
    });

    // --- Shape Logic ---
    document.querySelectorAll('.shape-option').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.shape-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const shape = btn.getAttribute('data-shape');
            qrCode.update({ dotsOptions: { type: shape } });
        });
    });

    // --- 9 EDGES Logic ---
    document.querySelectorAll('.edge-option').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.edge-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const edgeType = btn.getAttribute('data-edge'); 
            const dotType = btn.getAttribute('data-dot');   
            const edgeColor = btn.getAttribute('data-ecolor'); 
            const cornerSqObj = { type: edgeType };
            const cornerDtObj = { type: dotType };

            if(edgeColor) {
                if(btn.querySelector('.e-mix-color')) {
                    cornerSqObj.color = "#8B0000";
                    cornerDtObj.color = "#D4AF37";
                } else {
                    cornerSqObj.color = edgeColor;
                    cornerDtObj.color = edgeColor;
                }
            } else {
                const currentDotColor = document.getElementById('customColorDots').value;
                cornerSqObj.color = currentDotColor;
                cornerDtObj.color = currentDotColor;
            }

            qrCode.update({ 
                cornersSquareOptions: cornerSqObj,
                cornersDotOptions: cornerDtObj
            });
        });
    });

    // --- Logo Logic ---
    document.querySelectorAll('.logo-option').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.logo-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const logoUrl = btn.getAttribute('data-logo');
            qrCode.update({ image: logoUrl });
        });
    });

    document.getElementById('logoUploadInput').addEventListener('change', function(e) {
        if(e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function(event) {
                qrCode.update({ image: event.target.result });
                document.querySelectorAll('.logo-option').forEach(b => b.classList.remove('active'));
            }
            reader.readAsDataURL(e.target.files[0]);
        }
    });

    document.getElementById('removeLogoBtn').addEventListener('click', () => {
        qrCode.update({ image: "" });
        document.querySelectorAll('.logo-option').forEach(b => b.classList.remove('active'));
        document.querySelector('.logo-option[data-logo=""]').classList.add('active'); 
    });

    // --- Download ---
    document.getElementById("downloadBtn").addEventListener("click", () => {
        qrCode.download({ name: "QR-Studio-Export", extension: "png" });
    });

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 760) {
            document.getElementById("designStudio").classList.remove("hidden");
            document.getElementById("websitePanel").classList.remove("hidden");
            document.getElementById("quickPanel").classList.remove("hidden");
            document.getElementById("historyPanel").classList.remove("hidden");
        } else {
            if(designTab.classList.contains('active')){
                document.getElementById("websitePanel").classList.add("hidden");
            } else {
                document.getElementById("designStudio").classList.add("hidden");
            }
        }
    });
</script>
</body>
</html>
