/* =========================================================
   DARKLIGHT000999 — CYBERSECURITY AGENCY
   CRIMSON/GOLD DARK THEME
========================================================= */

:root{
    /* User Provided Theme Palette */
    --black: #050505;
    --black-2: #0a0a0a;
    --panel: #101010;
    --panel-2: #151515;
    --crimson: #8B0000;
    --crimson-bright: #b00000;
    --gold: #D4AF37;
    --gold-light: #f0d875;
    --silver: #F4F4F4;
    --silver-muted: #b8b8b8;
    --line: #292929;

    /* Mapped to layout variables */
    --bg: var(--black);
    --bg2: var(--black-2);
    --surface: rgba(16, 16, 16, 0.72);
    --surface2: rgba(21, 21, 21, 0.82);

    --text: var(--silver);
    --muted: var(--silver-muted);

    /* Mapped Old Accents to New Accents */
    --green: var(--crimson-bright);
    --cyan: var(--gold);
    --blue: var(--crimson);
    --purple: var(--gold-light);
    --pink: var(--crimson-bright);
    --orange: var(--gold);

    --border: var(--line);
    --border2: rgba(212, 175, 55, 0.20);

    --glow:
      0 0 25px rgba(176, 0, 0, 0.15),
      0 0 80px rgba(212, 175, 55, 0.06);

    --radius: 22px;
    --container: 1240px;

    --gradient:
      linear-gradient(
        120deg,
        var(--crimson),
        var(--crimson-bright),
        var(--gold),
        var(--gold-light),
        var(--crimson)
      );
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    overflow-x:hidden;

    font-family:"Inter",sans-serif;

    color:var(--text);

    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(176, 0, 0, 0.08),
        transparent 30%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(212, 175, 55, 0.08),
        transparent 30%
      ),
      radial-gradient(
        circle at 50% 100%,
        rgba(139, 0, 0, 0.08),
        transparent 35%
      ),
      var(--bg);

    transition:.35s ease;
}

/* LIGHT MODE - Adjusted slightly for contrast if toggled */
body.light{
    --bg:#f4f8fb;
    --bg2:#ffffff;
    --surface:rgba(255,255,255,.78);
    --surface2:rgba(245,249,252,.92);

    --text:#071118;
    --muted:#50656e;

    --border:rgba(139,0,0,.14);
    --border2:rgba(212,175,55,.14);

    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(176,0,0,.12),
        transparent 30%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(212,175,55,.10),
        transparent 30%
      ),
      var(--bg);
}

::selection{
    background:var(--crimson-bright);
    color:var(--black);
}

a{
    color:inherit;
}

button,
input,
textarea{
    font:inherit;
}


/* =========================================================
   BACKGROUND CANVAS
========================================================= */

#matrix{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    z-index:-5;
    opacity:.28;
}

body.light #matrix{
    opacity:.05;
}

.grid-bg{
    position:fixed;
    inset:0;
    z-index:-4;
    pointer-events:none;

    background-image:
      linear-gradient(
        rgba(176,0,0,.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(176,0,0,.035) 1px,
        transparent 1px
      );

    background-size:50px 50px;

    mask-image:linear-gradient(
        to bottom,
        black,
        transparent 90%
    );

    animation:gridMove 18s linear infinite;
}

@keyframes gridMove{
    from{
        background-position:0 0;
    }

    to{
        background-position:50px 50px;
    }
}

.noise{
    position:fixed;
    inset:0;
    z-index:-3;
    pointer-events:none;

    opacity:.035;

    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E");
}


/* =========================================================
   SCROLL PROGRESS
========================================================= */

.progress{
    position:fixed;
    top:0;
    left:0;

    width:0;
    height:3px;

    z-index:9999;

    background:var(--gradient);

    box-shadow:
      0 0 10px var(--crimson-bright),
      0 0 25px var(--gold);
}


/* =========================================================
   HEADER
========================================================= */

header{
    position:fixed;
    top:14px;
    left:50%;

    transform:translateX(-50%);

    width:min(
      calc(100% - 30px),
      var(--container)
    );

    height:70px;

    z-index:1000;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 16px;

    border:1px solid var(--border);

    border-radius:20px;

    background:rgba(10,10,10,.70);

    backdrop-filter:blur(20px);

    box-shadow:
      0 15px 50px rgba(0,0,0,.25),
      inset 0 1px rgba(255,255,255,.04);

    transition:.3s ease;
}

body.light header{
    background:rgba(255,255,255,.78);
}

header.scrolled{
    top:8px;

    height:62px;

    border-color:rgba(176,0,0,.30);

    box-shadow:
      0 15px 60px rgba(0,0,0,.20),
      0 0 30px rgba(176,0,0,.06);
}

.brand{
    display:flex;
    align-items:center;
    gap:11px;

    text-decoration:none;
}

.brand img{
    width:44px;
    height:44px;

    object-fit:cover;

    border-radius:12px;

    border:1px solid rgba(176,0,0,.35);

    box-shadow:
      0 0 15px rgba(176,0,0,.22);

    transition:.3s ease;
}

.brand:hover img{
    transform:rotate(-5deg) scale(1.06);
    box-shadow:
      0 0 25px rgba(176,0,0,.45);
}

.brand-name{
    font-family:"Orbitron",sans-serif;

    font-size:16px;
    font-weight:800;

    letter-spacing:1px;

    background:var(--gradient);

    background-size:300%;

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;

    animation:gradientText 6s linear infinite;
}

@keyframes gradientText{
    0%{background-position:0%}
    100%{background-position:300%}
}

.nav{
    display:flex;
    align-items:center;
    gap:4px;
}

.nav a{
    position:relative;

    padding:10px 13px;

    color:var(--muted);

    font-size:13px;
    font-weight:700;

    text-decoration:none;

    border-radius:10px;

    transition:.25s ease;
}

.nav a:hover{
    color:var(--text);
    background:rgba(255,255,255,.04);
}

.nav a::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:3px;

    width:0;
    height:2px;

    transform:translateX(-50%);

    border-radius:10px;

    background:var(--gradient);

    transition:.25s ease;
}

.nav a:hover::after{
    width:60%;
}

.header-actions{
    display:flex;
    gap:8px;
    align-items:center;
}

.icon-btn{
    width:42px;
    height:42px;

    display:grid;
    place-items:center;

    border:1px solid var(--border);

    border-radius:12px;

    background:rgba(255,255,255,.04);

    color:var(--text);

    cursor:pointer;

    transition:.25s ease;
}

.icon-btn:hover{
    transform:translateY(-2px);

    border-color:var(--green);

    box-shadow:
      0 0 20px rgba(176,0,0,.18);
}

.mobile-menu{
    display:none;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn{
    position:relative;

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;

    min-height:48px;

    padding:0 20px;

    border:0;
    border-radius:13px;

    background:var(--gradient);
    background-size:250% 250%;

    color:var(--black);

    font-size:13px;
    font-weight:900;

    letter-spacing:.5px;

    text-decoration:none;

    cursor:pointer;

    box-shadow:
      0 10px 35px rgba(176,0,0,.14);

    transition:
      transform .25s ease,
      box-shadow .25s ease,
      background-position .5s ease;

    overflow:hidden;
}

.btn::before{
    content:"";

    position:absolute;

    inset:0;

    background:linear-gradient(
      110deg,
      transparent 30%,
      rgba(255,255,255,.5),
      transparent 70%
    );

    transform:translateX(-120%);

    transition:.6s ease;
}

.btn:hover{
    transform:translateY(-3px);

    background-position:100%;

    box-shadow:
      0 15px 45px rgba(176,0,0,.25);
}

.btn:hover::before{
    transform:translateX(120%);
}

.btn-outline{
    background:transparent;

    color:var(--text);

    border:1px solid var(--border);
}

.btn-outline:hover{
    border-color:var(--green);
}


/* =========================================================
   MOBILE DRAWER
========================================================= */

.drawer{
    position:fixed;

    top:0;
    right:0;

    width:min(360px,88vw);
    height:100vh;

    z-index:2000;

    padding:25px;

    display:flex;
    flex-direction:column;

    background:
      linear-gradient(
        145deg,
        rgba(10,10,10,.98),
        rgba(5,5,5,.98)
      );

    border-left:1px solid var(--border);

    transform:translateX(105%);

    transition:
      transform .45s
      cubic-bezier(.22,1,.36,1);

    box-shadow:-30px 0 80px rgba(0,0,0,.45);
}

body.light .drawer{
    background:#fff;
}

.drawer.open{
    transform:translateX(0);
}

.drawer-top{
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding-bottom:20px;

    border-bottom:1px solid var(--border);
}

.drawer-links{
    display:flex;
    flex-direction:column;

    gap:8px;

    margin-top:25px;
}

.drawer-links a{
    padding:15px;

    border:1px solid var(--border);

    border-radius:13px;

    text-decoration:none;

    color:var(--muted);

    font-weight:700;

    transition:.25s ease;
}

.drawer-links a:hover{
    color:var(--text);

    border-color:var(--green);

    transform:translateX(-5px);
}

.scrim{
    position:fixed;
    inset:0;

    z-index:1500;

    background:rgba(0,0,0,.65);

    backdrop-filter:blur(5px);

    opacity:0;

    pointer-events:none;

    transition:.3s ease;
}

.scrim.show{
    opacity:1;
    pointer-events:auto;
}


/* =========================================================
   HERO
========================================================= */

.hero{
    position:relative;

    min-height:100vh;

    max-width:var(--container);

    margin:auto;

    padding:
      180px 20px
      100px;

    display:grid;

    grid-template-columns:
      1.15fr
      .85fr;

    align-items:center;

    gap:50px;
}

.hero-content{
    position:relative;
    z-index:2;
}

.status{
    display:inline-flex;

    align-items:center;
    gap:9px;

    padding:8px 13px;

    margin-bottom:22px;

    border:1px solid rgba(176,0,0,.20);

    border-radius:999px;

    background:rgba(176,0,0,.045);

    color:var(--gold-light);

    font-size:11px;
    font-weight:800;

    letter-spacing:.8px;

    text-transform:uppercase;
}

.status-dot{
    width:7px;
    height:7px;

    border-radius:50%;

    background:var(--green);

    box-shadow:
      0 0 8px var(--green),
      0 0 18px var(--green);

    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    0%,100%{
        transform:scale(1);
        opacity:1;
    }

    50%{
        transform:scale(1.5);
        opacity:.5;
    }
}

.hero h1{
    max-width:850px;

    font-family:"Orbitron",sans-serif;

    font-size:
      clamp(
        38px,
        6vw,
        78px
      );

    line-height:1.02;

    letter-spacing:-2px;

    margin-bottom:22px;
}

.hero h1 span{
    display:block;

    background:var(--gradient);
    background-size:300%;

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;

    animation:
      gradientText 7s linear infinite;
}

.hero-description{
    max-width:720px;

    color:var(--muted);

    font-size:16px;

    line-height:1.8;

    margin-bottom:30px;
}

.hero-buttons{
    display:flex;

    flex-wrap:wrap;

    gap:12px;
}

.hero-meta{
    display:flex;

    flex-wrap:wrap;

    gap:18px;

    margin-top:32px;

    color:var(--muted);

    font-size:11px;
    font-weight:700;
}

.hero-meta span{
    display:flex;
    align-items:center;
    gap:7px;
}

.hero-meta b{
    color:var(--green);
}


/* =========================================================
   CYBER HUD
========================================================= */

.hud{
    position:relative;

    width:min(440px,100%);
    aspect-ratio:1;

    margin:auto;

    display:grid;
    place-items:center;
}

.hud-core{
    position:absolute;

    width:42%;
    aspect-ratio:1;

    display:grid;
    place-items:center;

    border-radius:50%;

    background:
      radial-gradient(
        circle,
        rgba(176,0,0,.24),
        rgba(212,175,55,.08) 40%,
        transparent 70%
      );

    border:1px solid rgba(176,0,0,.35);

    box-shadow:
      0 0 30px rgba(176,0,0,.20),
      0 0 100px rgba(212,175,55,.12);

    animation:corePulse 3s ease-in-out infinite;
}

@keyframes corePulse{
    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.06);
    }
}

.core-logo{
    width:72px;
    height:72px;

    object-fit:cover;

    border-radius:20px;

    border:1px solid rgba(176,0,0,.45);

    box-shadow:
      0 0 25px rgba(176,0,0,.3);
}

.ring{
    position:absolute;

    border-radius:50%;

    border:1px solid rgba(176,0,0,.18);
}

.ring.one{
    width:58%;
    height:58%;

    border-top-color:var(--green);

    animation:spin 10s linear infinite;
}

.ring.two{
    width:73%;
    height:73%;

    border-right-color:var(--cyan);

    animation:spinReverse 14s linear infinite;
}

.ring.three{
    width:88%;
    height:88%;

    border-bottom-color:var(--purple);

    animation:spin 20s linear infinite;
}

@keyframes spin{
    to{
        transform:rotate(360deg);
    }
}

@keyframes spinReverse{
    to{
        transform:rotate(-360deg);
    }
}

.hud::before{
    content:"";

    position:absolute;

    width:100%;
    height:100%;

    border-radius:50%;

    background:
      repeating-conic-gradient(
        from 0deg,
        rgba(176,0,0,.4) 0deg 1deg,
        transparent 1deg 14deg
      );

    mask:
      radial-gradient(
        transparent 67%,
        black 68%,
        black 69%,
        transparent 70%
      );

    animation:spin 35s linear infinite;
}

.hud-label{
    position:absolute;

    padding:7px 10px;

    border:1px solid var(--border);

    border-radius:8px;

    background:rgba(10,10,10,.75);

    backdrop-filter:blur(8px);

    color:var(--muted);

    font-family:"Orbitron";

    font-size:8px;

    letter-spacing:1px;
}

.hud-label.top{
    top:5%;
    left:50%;
    transform:translateX(-50%);
}

.hud-label.right{
    right:-1%;
    top:48%;
}

.hud-label.bottom{
    bottom:5%;
    left:50%;
    transform:translateX(-50%);
}

.hud-label.left{
    left:-1%;
    top:48%;
}


/* =========================================================
   MAIN
========================================================= */

main{
    max-width:var(--container);

    margin:auto;

    padding:
      30px 20px
      80px;
}

section{
    scroll-margin-top:110px;

    margin:100px 0;
}

.section-head{
    max-width:760px;

    margin:0 auto 45px;

    text-align:center;
}

.eyebrow{
    color:var(--green);

    font-family:"Orbitron";

    font-size:10px;

    letter-spacing:2px;

    text-transform:uppercase;

    margin-bottom:12px;
}

.section-title{
    font-family:"Orbitron";

    font-size:
      clamp(25px,4vw,42px);

    margin-bottom:14px;

    letter-spacing:-.5px;
}

.section-title span{
    background:var(--gradient);

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;
}

.section-description{
    color:var(--muted);

    line-height:1.8;

    font-size:14px;
}


/* =========================================================
   TRUST BAR
========================================================= */

.trust{
    display:grid;

    grid-template-columns:
      repeat(4,1fr);

    gap:12px;

    margin-top:10px;
}

.trust-item{
    padding:18px;

    text-align:center;

    border:1px solid var(--border);

    border-radius:16px;

    background:rgba(255,255,255,.025);

    color:var(--muted);

    font-size:11px;
    font-weight:700;
}

.trust-item strong{
    display:block;

    color:var(--text);

    font-size:16px;

    margin-bottom:4px;
}


/* =========================================================
   CARDS
========================================================= */

.grid{
    display:grid;

    grid-template-columns:
      repeat(
        auto-fit,
        minmax(260px,1fr)
      );

    gap:18px;
}

.card{
    position:relative;

    min-height:220px;

    padding:25px;

    overflow:hidden;

    border:1px solid var(--border);

    border-radius:var(--radius);

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.045),
        rgba(255,255,255,.015)
      );

    box-shadow:var(--glow);

    transition:
      transform .35s ease,
      border-color .35s ease,
      box-shadow .35s ease;
}

.card::before{
    content:"";

    position:absolute;

    top:0;
    left:0;

    width:100%;
    height:2px;

    background:var(--gradient);

    transform:scaleX(.2);

    transform-origin:left;

    transition:.35s ease;
}

.card::after{
    content:"";

    position:absolute;

    width:180px;
    height:180px;

    right:-80px;
    bottom:-90px;

    border-radius:50%;

    background:var(--green);

    filter:blur(80px);

    opacity:.06;

    transition:.35s ease;
}

.card:hover{
    transform:
      translateY(-9px)
      rotateX(2deg);

    border-color:rgba(176,0,0,.38);

    box-shadow:
      0 20px 60px rgba(0,0,0,.25),
      0 0 35px rgba(176,0,0,.10);
}

.card:hover::before{
    transform:scaleX(1);
}

.card:hover::after{
    opacity:.13;
}

.card-icon{
    width:52px;
    height:52px;

    display:grid;
    place-items:center;

    margin-bottom:20px;

    border-radius:15px;

    border:1px solid var(--border);

    background:
      linear-gradient(
        135deg,
        rgba(176,0,0,.10),
        rgba(212,175,55,.04)
      );

    font-size:23px;

    box-shadow:
      inset 0 0 20px rgba(176,0,0,.04);
}

.card h3{
    font-size:17px;

    margin-bottom:10px;
}

.card p{
    color:var(--muted);

    line-height:1.7;

    font-size:13px;
}


/* =========================================================
   STATS
========================================================= */

.stats{
    display:grid;

    grid-template-columns:
      repeat(4,1fr);

    gap:16px;
}

.stat{
    position:relative;

    padding:28px 20px;

    text-align:center;

    overflow:hidden;

    border:1px solid var(--border);

    border-radius:20px;

    background:var(--surface);

    backdrop-filter:blur(12px);
}

.stat::before{
    content:"";

    position:absolute;

    inset:0;

    background:var(--gradient);

    opacity:.035;
}

.stat-number{
    position:relative;

    font-family:"Orbitron";

    font-size:
      clamp(27px,4vw,42px);

    font-weight:800;

    background:var(--gradient);

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;
}

.stat-label{
    position:relative;

    color:var(--muted);

    font-size:11px;

    margin-top:7px;
}


/* =========================================================
   SECURITY TERMINAL
========================================================= */

.terminal{
    overflow:hidden;

    border:1px solid var(--border);

    border-radius:20px;

    background:var(--black);

    box-shadow:
      0 30px 90px rgba(0,0,0,.3),
      0 0 30px rgba(176,0,0,.05);
}

.terminal-head{
    display:flex;
    align-items:center;

    gap:7px;

    padding:13px 17px;

    border-bottom:1px solid rgba(255,255,255,.07);

    background:rgba(255,255,255,.025);
}

.term-dot{
    width:9px;
    height:9px;

    border-radius:50%;

    background:var(--muted);
}

.term-title{
    margin-left:8px;

    color:var(--muted);

    font-size:10px;

    font-family:monospace;
}

