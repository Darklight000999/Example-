========================================================= */

.download-bar{
    position:fixed;

    z-index:100;

    left:0;
    right:0;
    bottom:0;

    padding:
        9px
        12px
        calc(9px + env(safe-area-inset-bottom));

    background:
        linear-gradient(
            180deg,
            rgba(5,8,20,.15),
            rgba(5,8,20,.88)
