    border-radius:14px;

    border:1px solid var(--border);

    background:
        rgba(255,255,255,.055);

    color:white;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:5px;

    transition:.2s;
}

.quick:active{
    transform:scale(.94);
}

.quick-icon{
    font-size:20px;
}

.quick-name{
    font-size:8px;

    color:var(--muted);

    font-weight:800;
}

